# ============================================================
# Tradi Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# ============================================================

# --- Vite dev server API proxy target (existing engine backend) ---
# VITE_API_URL=http://127.0.0.1:8899

# --- Supabase (required for auth + data) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Paystack (billing, not needed yet) ---
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...

# --- Monitoring (Phase 7) — optional, app runs fine without it ---
# Sentry error tracking. Unset (default) -> no-op, zero network calls (D-M1).
# Create the project in sentry.io manually, then set the frontend's own DSN here.
# VITE_SENTRY_DSN=https://example@sentry.io/0
