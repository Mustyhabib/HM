# Copy to .env and fill in. Never commit the real .env.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It belongs only in the
# worker's environment — never in the frontend, never in a VITE_* variable,
# never in git.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — stable id makes claims traceable in agent_runs.claimed_by.
# Defaults to <hostname>-<random8>.
# WORKER_ID=worker-1

# Seconds to pause after finishing a run before claiming the next.
WORKER_POLL_INTERVAL_SECONDS=2

# Seconds to sleep when the queue is empty.
WORKER_IDLE_BACKOFF_SECONDS=10

# How often to refresh the claim during a long run.
WORKER_HEARTBEAT_SECONDS=30

# Wall-clock budget for a single run (enforced by the runner, Day 5).
WORKER_RUN_TIMEOUT_SECONDS=900

# A run whose heartbeat is older than this is treated as abandoned and
# reclaimed. Must exceed WORKER_RUN_TIMEOUT_SECONDS. Defaults to timeout + 300.
# WORKER_STALE_AFTER_SECONDS=1200

# Set true to run the real engine (TradiRunner); false/unset uses the stub
# runner (sleeps and succeeds — no engine, no LLM).
WORKER_EXECUTE_TRADI=false
WORKER_STUB_DURATION_SECONDS=3

# --- TradiRunner (only used when WORKER_EXECUTE_TRADI=true) ---
# How the worker launches the engine. Default assumes `vibe-trading` is on PATH
# (engine installed via `pip install -e Tradi/`).
# WORKER_TRADI_COMMAND=/abs/path/to/Tradi/.venv/bin/vibe-trading
#
# LLM routing (BUG-ENG-4, 2026-08-22): the worker INJECTS these into every
# engine subprocess, because the upstream engine (>= 1907e47) hard-requires
# LANGCHAIN_PROVIDER / LANGCHAIN_MODEL_NAME and the Docker image ships no
# agent/.env. Defaults match the engine provider catalog's DeepSeek entry.
# The user's own BYOK key is always injected separately as DEEPSEEK_API_KEY.
# WORKER_LLM_PROVIDER=deepseek
# WORKER_LLM_MODEL=deepseek-v4-pro
#
# Per-run isolated HOME dirs (config/sessions/runs/memory) live under here — must
# be WRITABLE by the worker user. Default /var/vibe-runs needs root/pre-creation;
# for local dev use e.g. /tmp/vibe-runs.
# WORKER_RUNS_ROOT=/tmp/vibe-runs

LOG_LEVEL=INFO

# --- Monitoring (Phase 7) — both fully optional, worker runs fine without them ---
# Sentry error tracking. Unset (default) -> no-op, zero network calls (D-M1).
# Create the project in sentry.io manually, then set the worker's own DSN here.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Health endpoint (GET /health -> {status, queue_depth, last_poll_at}).
# Default bind is 0.0.0.0 so Railway's healthcheck can reach the container.
# Set WORKER_HEALTH_HOST=127.0.0.1 for local-only access during development.
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=9100
